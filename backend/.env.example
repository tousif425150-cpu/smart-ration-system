# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/smart_ration_db"

# JWT Configuration
JWT_SECRET="your-very-long-and-secure-jwt-secret-key-change-this-in-production"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server Configuration
PORT=5000
NODE_ENV="development"

# Admin Panel Origin (for CORS)
ADMIN_PANEL_ORIGIN="http://localhost:5173"

# File Upload
UPLOAD_DIR="uploads"
MAX_FILE_SIZE=5242880
