# Monorepo Root Gitignore

# Dependency directories
node_modules/
backend/node_modules/
admin-panel/node_modules/
android-app/node_modules/

# Build outputs
dist/
backend/dist/
admin-panel/dist/
build/
android-app/build/
android-app/app/build/
bin/
out/

# Environment variables and secrets
.env
.env.production
.env.local
.env.development
!.env.example
firebase-key.json
google-services.json
*.keystore
*.jks
release.keystore

# IDE and OS files
.idea/
.vscode/
.gradle/
android-app/.gradle/
android-app/.idea/
*.iml
.DS_Store
Thumbs.db
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Application data
uploads/
backend/uploads/*
!backend/uploads/.gitkeep
